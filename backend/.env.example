# =============================================================================
# AdvanCare backend — local secrets template
#
#   1. Copy this file:   cp .env.example .env      (inside backend/)
#   2. Fill in the values below.
#   3. Never commit .env — it is git-ignored. Only this template is committed.
#
# Who reads backend/.env:
#   - `npm run dev`         (wrangler loads it into the Worker)
#   - `npm run db:migrate`  (drizzle-kit uses DATABASE_URL)
#   - `npm test`            (if DATABASE_URL is set, the real-database health test runs)
#
# This is NOT the .env in the project root (that one holds demo login notes).
#
# For production, do not use this file. Store each secret in Cloudflare:
#   npx wrangler secret put DATABASE_URL --env production
#   npx wrangler secret put R2_ACCOUNT_ID --env production
#   npx wrangler secret put GEMINI_API_KEY --env production
#   ...and so on for every secret below.
# =============================================================================


# -----------------------------------------------------------------------------
# NEON (PostgreSQL database)
# -----------------------------------------------------------------------------
# Where: console.neon.tech → your project → Dashboard → "Connect" button.
#   - Pick the database (e.g. advancare) and role.
#   - Turn "Connection pooling" OFF (use the direct connection, not "-pooler").
#   - Copy the full string. It must end with ?sslmode=require
# Looks like:
#   postgresql://neondb_owner:AbC123xyz@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/advancare?sslmode=require
DATABASE_URL=""


# -----------------------------------------------------------------------------
# CLOUDFLARE R2 (file uploads: prescriptions, photos, PDFs)
# -----------------------------------------------------------------------------
# Account ID
# Where: dash.cloudflare.com → R2 Object Storage → right-hand side "Account Details",
#        or the 32-character ID in the dashboard URL: dash.cloudflare.com/<ACCOUNT_ID>/...
R2_ACCOUNT_ID=""

# R2 API token (S3-compatible keys)
# Where: dash.cloudflare.com → R2 Object Storage → "Manage API tokens" → "Create API token".
#   - Permissions: "Object Read & Write"
#   - Scope it to the buckets: advancare-uploads-dev (and advancare-uploads for production)
#   - After you click Create, Cloudflare shows the two values ONCE. Copy both now:
#       "Access Key ID"      → R2_ACCESS_KEY_ID
#       "Secret Access Key"  → R2_SECRET_ACCESS_KEY
#   (Ignore the "Token value" shown on the same screen; this API does not use it.)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Bucket names are NOT secrets; they live in wrangler.toml:
#   local dev  → advancare-uploads-dev
#   production → advancare-uploads
# Create both in dash.cloudflare.com → R2 Object Storage → "Create bucket".


# -----------------------------------------------------------------------------
# GOOGLE AI STUDIO / GEMINI (Care Assistant)
# -----------------------------------------------------------------------------
# API key
# Where: aistudio.google.com → "Get API key" (left sidebar) → "Create API key"
#        → pick or create a Google Cloud project → copy the key (starts with "AIza").
# Keep it here (backend) only. NEVER put it in frontend/.env.local: anything named
# VITE_* is bundled into the PWA and readable by anyone who installs the app.
#
# Privacy: on the FREE tier, Google may use prompts and responses to improve its
# products. Before real client/patient conversations go through the assistant, turn
# on billing for the AI Studio project (paid tier is not used for training) to stay
# within the Data Privacy Act consent you collect.
GEMINI_API_KEY=""

# Models (not secret; these are the defaults if left as-is)
# Primary: newest, fastest/cheapest of the 3.5 family.
GEMINI_MODEL="gemini-3.5-flash-lite"
# Fallback: used if the primary is unavailable or rate-limited.
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"


# -----------------------------------------------------------------------------
# STAFF CONSOLE (admin/) — ADR-011
# -----------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts staff authenticator (2FA) secrets and signs sign-in steps.
# Generate:  openssl rand -base64 32
# Changing it later makes every enrolled authenticator unusable (everyone re-enrolls 2FA),
# so generate it once per environment and keep it.
STAFF_ENCRYPTION_KEY=""


# -----------------------------------------------------------------------------
# EMAIL (app sign-in codes) — Gmail for now, instead of paid SMS
# -----------------------------------------------------------------------------
# Leave SMTP_USER / SMTP_PASSWORD empty in local development: the code is then printed
# in the API log ("devMail") instead of emailed. Production refuses to start sign-in without them.
#
# To send through Gmail:
#   1. Use (or create) the Gmail account the emails should come from.
#   2. Turn on 2-Step Verification: myaccount.google.com → Security.
#   3. Create an App Password: myaccount.google.com/apppasswords → name it "AdvanCare API"
#      → copy the 16-character password (spaces don't matter).
#   4. Put the address in SMTP_USER and the App Password in SMTP_PASSWORD.
# Gmail allows about 500 emails a day from a regular account, enough for the pilot.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Optional: shown as the sender (defaults to SMTP_USER and "AdvanCare").
MAIL_FROM=""
MAIL_FROM_NAME="AdvanCare"


# -----------------------------------------------------------------------------
# NOT IN THIS FILE (for reference)
# -----------------------------------------------------------------------------
# Hyperdrive ID — production only, goes in wrangler.toml (replace REPLACE_WITH_HYPERDRIVE_ID).
#   Create it with your Neon URL:
#     npx wrangler hyperdrive create advancare-neon --connection-string="<DATABASE_URL>"
#   It prints an id; paste that into wrangler.toml under [[env.production.hyperdrive]].
#
# Cloudflare login — no API key needed here. Run once:  npx wrangler login
#
# ALLOWED_ORIGINS — not secret; set in wrangler.toml (dev already allows localhost:5174).
