# Copy to .env.local for an entirely local API. This file is separate from .env (Neon).
# Replace YOUR_MAC_USERNAME with the PostgreSQL role on your Mac.
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/advancare_local
DATABASE_URL_UNPOOLED=postgresql://YOUR_MAC_USERNAME@localhost:5432/advancare_local
# Generate once: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
# Keep this key stable: it encrypts local staff authenticator secrets.
STAFF_ENCRYPTION_KEY=""
# No external delivery/services in local mode. Sign-in codes appear in the API log.
SMTP_USER=""
SMTP_PASSWORD=""
GEMINI_API_KEY=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
