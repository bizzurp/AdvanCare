{
  "name": "advancare-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local --env-file .env.local",
    "db:migrate:local": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "admin:bootstrap:local": "node --env-file=.env.local scripts/bootstrap-admin.ts",
    "build": "tsc --noEmit && wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "admin:bootstrap": "node scripts/bootstrap-admin.ts",
    "db:seed-demo": "node scripts/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hono/valibot-validator": "^0.6.1",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
