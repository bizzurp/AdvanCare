# Base URL of the AdvanCare Workers API (ADV-CORE-001). Leave unset to run in demo mode:
# requests are then kept on this device only and are never shown as sent to a provider.
VITE_API_BASE_URL=

# Do NOT put API keys here (Gemini, R2, Neon). Every VITE_* value is bundled into the
# app and visible to anyone who opens it. AI keys live in backend/.env; the Care
# Assistant calls them through the API.
